# Frontend: build the React app, serve the static bundle with nginx
# (production-style static serving; `vite preview` is dev-only).
# Build context is the repo root so both Dockerfiles share one context.

# ---- build ----
FROM node:20-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Baked into the bundle at build time; must be reachable from the *browser*,
# not from inside the container network.
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# ---- serve ----
FROM nginx:alpine
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
