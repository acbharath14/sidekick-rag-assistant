# Backend: FastAPI RAG API (Python 3.12-slim).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY src/ ./src/
COPY docs/ ./docs/
COPY scripts/ ./scripts/
COPY app.py ARCHITECTURE.md README.md SPEC.md LICENSE ./

# push-files always creates mode 100644, so set exec bits here instead of
# relying on the repo checkout.
RUN chmod +x scripts/docker-entrypoint.sh

# Persistent state (FAISS index, conversations.db, LanceDB episodic memory)
# lives under /data via RAG_DEMO_INDEX_DIR.
ENV RAG_DEMO_INDEX_DIR=/data/index

EXPOSE 8000

ENTRYPOINT ["scripts/docker-entrypoint.sh"]
CMD ["uvicorn", "rag_demo.api:app", "--host", "0.0.0.0", "--port", "8000"]
